# ============================================================
# Django Core Settings
# ============================================================
# Secret key for Django (required in production)
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production

# Debug mode (set to False in production)
DEBUG=True

# Comma-separated list of allowed hosts
# Example: ["teklora.co.ke","www.teklora.co.ke","127.0.0.1","localhost"]
ALLOWED_HOSTS=["teklora.co.ke","www.teklora.co.ke","127.0.0.1","localhost"]

# ============================================================
# Email Configuration
# ============================================================
# Mailgun is the transport. Setting the key and domain selects it; without
# them the SMTP settings below are used, and without those mail is printed to
# the console. That last fallback is refused when DEBUG is off, because it
# reports every message as sent while delivering nothing.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.teklora.co.ke

# API root only -- do NOT append the domain. EU-region accounts use
# https://api.eu.mailgun.net/v3 instead.
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# The public From address. Defaults to noreply@MAILGUN_DOMAIN. Anything
# outside the sending domain fails SPF/DKIM alignment and lands in spam.
DEFAULT_FROM_EMAIL=

# Seconds to wait on the Mailgun API (or on SMTP, when that is in use).
EMAIL_TIMEOUT=10

# Optional. "An article is waiting for review" is addressed to whoever holds
# the publish_blog capability, so this normally needs no value. It is only a
# fallback for a fresh deployment where nobody has been granted it yet.
EDITORIAL_REVIEW_EMAIL=

# ============================================================
# Team seeding
# ============================================================
# Addresses invited onto the panel on deployment, once each. NOT a notification
# list -- notifications go to whoever holds the relevant capability, so an
# invitation nobody accepts means nobody is mailed. Adding a colleague later is
# an invitation from the panel, not an edit here.
# JSON list; leave unset to keep the founding team baked into config.py.
# TEAM_SEED_EMAILS=["someone@example.com"]

# Preset role a seeded invitation carries. Support = view_inbox +
# handle_inquiries + manage_appointments, the capabilities the contact-form and
# booking notifications are addressed by.
TEAM_SEED_ROLE=Support

# --- SMTP fallback -----------------------------------------------------
# Only used when MAILGUN_API_KEY/MAILGUN_DOMAIN are empty. Note that Gmail
# caps a consumer account near 500 recipients a day and Workspace near 2,000,
# which the bulk outbox will exhaust in minutes -- this is a development
# convenience, not a route for campaign mail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# For Gmail this must be an App Password, not the account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ============================================================
# Gemini API Configuration
# ============================================================
# Google Gemini API key (required)
GOOGLE_API_KEY=your-google-api-key-here

# Gemini Model Configuration (Optional)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001

# ============================================================
# LangSmith Configuration (Optional)
# ============================================================
# Enable/disable LangSmith tracing (set to true/false as lowercase string)
LANGSMITH_TRACING=true

# LangSmith API key (optional, but required if tracing is enabled)
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here

# LangSmith project name (defaults to "brantech-ai")
LANGSMITH_PROJECT=brantech-ai

# ============================================================
# Database Configuration
# ============================================================
# Database engine: "postgresql" or "sqlite3"
DATABASE_ENGINE=postgresql

# ============================================================
# GitHub Integration Configuration
# ============================================================
# Generating a personal access token: https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=your-github-personal-access-token
GITHUB_USERNAME=your-github-username

# PostgreSQL Database Settings (required if DATABASE_ENGINE=postgresql)
DATABASE_NAME=brantech
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# ============================================================
# Docker / Cloudflare Tunnel (used by docker-compose at repo root)
# ============================================================
# When running via Docker, place a copy of this file as `.env` at the REPO ROOT
# (next to docker-compose.yml). Compose injects these as real env vars, which
# pydantic-settings reads directly — no in-container .env file is required.

# In Docker the app talks to the bundled Postgres service by name:
# DATABASE_HOST=db

# Set DEBUG=False for production behind the tunnel:
# DEBUG=False

# Set ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS to your real domain. The latter is
# REQUIRED behind the tunnel (TLS terminates at Cloudflare) or all form/admin
# POSTs return HTTP 403. Include the https:// scheme on CSRF origins:
# ALLOWED_HOSTS=["your-domain.com","www.your-domain.com"]
# CSRF_TRUSTED_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# Static/media filesystem roots inside the container (defaults are fine):
# STATIC_ROOT=/app/brandtechsolution/staticfiles
# MEDIA_ROOT=/app/brandtechsolution/media

# Cloudflare Tunnel token:
# The token is NOT placed in this root .env. To keep it out of the web
# container's environment and off the process command line, put it in a
# SEPARATE file `cloudflared.env` at the repo root (gitignored):
#
#   # cloudflared.env
#   TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
#
# Create the tunnel in the Cloudflare Zero Trust dashboard and add a public
# hostname routing to http://web:8000, then paste its token into cloudflared.env.
# ============================================================
# Cloudflare Turnstile (bot protection on the public forms)
# ============================================================
# Create a widget at Cloudflare dashboard -> Turnstile, add your hostnames,
# then paste both keys here. The site key is public and rendered into the
# page; the secret key is only ever sent server-to-server to siteverify.
#
# Leave both empty for local development: the widget stops rendering and the
# server stops verifying, so the two never disagree. Django refuses to start
# with DEBUG=false and no secret key, so production cannot lose its bot
# protection silently.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# Redis (Celery broker, result backend, and Django cache)
# ============================================================
# One instance, three logical databases: broker on db 0, results on db 1,
# cache on db 2. Separate databases so clearing the cache can never drop
# queued work.
#
# In docker compose the host is the `redis` service and this is set for you.
# On a developer machine, leave it as localhost and run Redis, or see
# CELERY_TASK_ALWAYS_EAGER below to work without one.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Celery
# ============================================================
# Run tasks inline in the calling process instead of queueing them. Set this
# to true on a developer machine with no worker running: the editorial
# pipeline then blocks its request again, but nothing silently never runs.
# The test suite forces it on regardless, so tests never need a broker.
CELERY_TASK_ALWAYS_EAGER=false

# Ceilings for a single task, in seconds. The editorial pipeline makes eight
# sequential Gemini calls and routinely takes three minutes; the soft limit
# fires first and is caught to record the failure against the run.
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=1200

# Prefork slots per worker container. The tasks are I/O-bound on the Gemini
# API, but each child holds a full LangChain import, so raise this with an eye
# on memory.
CELERY_WORKER_CONCURRENCY=2

# Beat intervals, in seconds. The outbox interval replaces the old
# `sleep 60` loop in the retired `outbox` compose service.
BEAT_OUTBOX_INTERVAL=60
BEAT_GITHUB_SYNC_INTERVAL=3600
